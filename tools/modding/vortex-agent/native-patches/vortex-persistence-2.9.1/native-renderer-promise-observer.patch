+async function observeNativeRendererPromise<T>(flight: PromiseLike<T>, fulfilled: (value: T) => void, rejected: (primary: unknown) => void): Promise<void> {
+  let value: T;
+  try { value = await flight; }
+  catch (primary) { try { rejected(primary); } catch { /* Observe callback failure without replacing the original primary. */ } return; }
