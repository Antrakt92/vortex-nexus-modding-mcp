+// Preload executes before renderer imports telemetry/Zone.js in this shared
+// context. Retain the genuine native constructor/method before global Promise
+// and its prototype methods can be replaced. Never borrow a later Zone then.
+const nativeExecutorPreloadPromise: PromiseConstructor = Promise;
+const nativeExecutorPreloadThen = nativeExecutorPreloadPromise.prototype.then;
+function nativeExecutorPreloadObserve(flight: Promise<unknown>, settled: (value: unknown) => void, failed: () => void): void {
+  const observed = nativeExecutorPreloadThen.call(flight, settled, failed);
+  // Observe callback failures with the same captured intrinsic. A dynamic
+  // .catch would borrow the possibly patched Promise.prototype.then again.
+  void nativeExecutorPreloadThen.call(observed, undefined, () => {});
+}
