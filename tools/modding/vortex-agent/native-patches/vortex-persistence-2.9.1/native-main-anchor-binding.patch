+/** Strict main-private read bound to the actual initialized selected backend. */
+export async function readNativeExecutorHistoryAnchor(owner: object): Promise<Uint8Array | null> {
+  checkNativeMainPersistenceReady(owner);
+  const attempt = nativeMainAttempt;
+  if (attempt === undefined || attempt.owner !== owner) throw new Error("NATIVE_EXECUTOR_ANCHOR_HOLD");
+  const backend = attempt.backend;
+  const bytes = await nativeHistoryAnchorRead.call(backend);
+  checkNativeMainPersistenceReady(owner);
+  if (nativeMainAttempt !== attempt || levelPersist !== backend) throw new Error("NATIVE_EXECUTOR_ANCHOR_HOLD");
+  const result = bytes === null ? null : new Uint8Array(Buffer.from(JSON.stringify(nativeHistoryAnchorSnapshot(bytes))));
+  checkNativeMainPersistenceReady(owner);
+  if (nativeMainAttempt !== attempt || levelPersist !== backend) throw new Error("NATIVE_EXECUTOR_ANCHOR_HOLD");
+  return result;
+}
